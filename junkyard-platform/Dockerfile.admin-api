# The admin SPA (admin_ui/), built here and served by the API from STATIC_DIR.
FROM node:22-slim AS ui
WORKDIR /ui
COPY admin_ui/package.json admin_ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY admin_ui/ ./
RUN npm run build

# 3.12, not 3.13: the admin calls the cluster API (ScrapeJob run-now), and Python 3.13's strict X.509 check
# rejects the microk8s CA (web-scrapers/scrape-job-manager/docs/issues/2026_10_10_microk8s_ca_rejected_by_python_313.md).
FROM python:3.12-slim
WORKDIR /app
# junkyard_common from this tree (not PyPI), so the image always has the schema the migrations describe.
COPY pyproject.toml ./
COPY junkyard_common/ ./junkyard_common/
COPY admin_api/requirements.txt ./admin_api_requirements.txt
COPY pipeline/requirements.txt ./pipeline_requirements.txt
RUN pip install --no-cache-dir . \
 && cat admin_api_requirements.txt pipeline_requirements.txt | grep -v '^dwilson-junkyard-common' > reqs.txt \
 && pip install --no-cache-dir -r reqs.txt "sqlalchemy>=2.0,<2.1"
COPY admin_api/ ./admin_api/
COPY pipeline/ ./pipeline/
COPY --from=ui /ui/dist/ ./static/
ENV STATIC_DIR=/app/static
EXPOSE 8300
CMD ["uvicorn", "admin_api.main:app", "--host", "0.0.0.0", "--port", "8300"]
